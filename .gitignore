build/
core/
sketch/
*.bin
*.elf
*.hex
*.map
*.o
*.d
*.obj
*.exe

# vendored libraries (this project deliberately vendors nothing)
libraries/
.lib_build/

# ---- captured logs and data --------------------------------------------------
*.csv
*.log

# ---- Python (docs/img generators) -------------------------------------------
__pycache__/
*.pyc
.venv/

# ---- editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- tool config that is machine-specific -----------------------------------
arduino-cli.yaml
arduino-cli.yaml.bak
